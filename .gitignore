# venv / tooling
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# local config and profiles (examples are committed)
config.yaml
profiles/*.yaml
!profiles/*.example.yaml
profiles/*.proposed.yaml

# runtime data
data/
captures/
